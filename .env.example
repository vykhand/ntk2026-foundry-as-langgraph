# ── Model provider ───────────────────────────────────────────────────────────
# foundry | ollama | openai   (default: foundry when FOUNDRY_PROJECT_ENDPOINT is set, else ollama)
LLM_PROVIDER=ollama

# Act 1 (offline): local model via Ollama's OpenAI-compatible endpoint
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gpt-oss:20b
# Reasoning models think before answering; "low" keeps the Act 1 answer under ~20 s on an M4 Max
# (measured 2026-09-05: low 17 s vs default 53–145 s). Fallback model: qwen3:8b (better Slovene, slower).
LLM_REASONING_EFFORT=low

# Cloud (Acts 2–3): injected by Foundry in hosted containers and by `azd ai agent run`
# from the azd environment. Set manually only when running the host directly.
#FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
#AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini
# `uv run invoke` / `uv run rollback` authenticate with DefaultAzureCredential. On a laptop where
# `az` is signed in to several tenants, pin the chain to the azd login (the demo tenant):
#AZURE_TOKEN_CREDENTIALS=azuredeveloperclicredential
# This project's own az profile, so another session's default subscription cannot change who the
# bot and azd are. `uv run az-login` adds this line and signs in; `uv run az-login --check` verifies.
#AZURE_CONFIG_DIR=/Users/<you>/.azure-ntk2026

# Generic OpenAI-compatible endpoint (LLM_PROVIDER=openai)
#OPENAI_API_KEY=
#OPENAI_BASE_URL=
#OPENAI_MODEL=

# ── Agent configuration ──────────────────────────────────────────────────────
# Which attendee profile the `preferences` tool returns by default (fixtures/personas.json)
NTK_ATTENDEE=maja
# System prompt file; the deliberately mediocre baseline is the default (see prompts/baseline_v1.md)
NTK_PROMPT_FILE=prompts/baseline_v1.md
# Override the prompt text entirely (wins over NTK_PROMPT_FILE) — env vars are immutable per version
#NTK_SYSTEM_PROMPT=
# Program fixture path (defaults to fixtures/program.json)
#NTK_PROGRAM_PATH=

# ── Hosting ──────────────────────────────────────────────────────────────────
PORT=8088
# Telemetry: with no exporter configured the agent server prints every span and a metrics dump
# per minute to the terminal, so src/hosting/telemetry.py sets OTEL_SDK_DISABLED=true for purely
# local runs. Hosted containers get APPLICATIONINSIGHTS_CONNECTION_STRING injected and stay on.
# Act 3 rehearsal from the laptop: set the connection string (and optionally the two toggles).
#APPLICATIONINSIGHTS_CONNECTION_STRING=
#OTEL_AUTO_CONFIGURE_AZURE_MONITOR=true
#AZURE_TRACING_GEN_AI_CONTENT_RECORDING_ENABLED=true
#OTEL_SDK_DISABLED=false
